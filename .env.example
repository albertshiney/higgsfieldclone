# ───────────────────────────────────────────────────────────────────────────
# Vireo environment. Copy to .env.local for development.
# Production refuses to boot without every variable marked (required).
# ───────────────────────────────────────────────────────────────────────────

# App ------------------------------------------------------------------------
# Public origin (used in emails, Stripe return URLs, dev media URLs).
APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Vireo
# Optional dismissible promo bar above the nav (empty hides it).
NEXT_PUBLIC_PROMO_BAR=
NEXT_PUBLIC_PROMO_HREF=/pricing

# Auth.js --------------------------------------------------------------------
# (required) `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# (required) Resend API key; the sending domain must be verified in Resend.
# Empty in development → magic links are printed to the server log.
AUTH_RESEND_KEY=
EMAIL_FROM="Vireo <login@vireo.studio>"
SUPPORT_EMAIL=support@vireo.studio
# Credits granted once at sign-up (top-up bucket, never expire).
SIGNUP_BONUS_CREDITS=0
# Comma-separated emails that get the admin role.
ADMIN_EMAILS=
# Block throwaway inboxes at sign-in.
BLOCK_DISPOSABLE_EMAIL=true

# MongoDB --------------------------------------------------------------------
# (required) A replica set (Atlas, or `pnpm db:dev` locally) — transactions need one.
MONGODB_URI=
MONGODB_DB=vireo-studio

# Higgsfield -----------------------------------------------------------------
HF_API_BASE_URL=https://api.higgsfield.ai
# (required) key_id:key_secret from https://console.higgsfield.ai
HF_CREDENTIALS=key_id:key_secret
# (required) Signs webhook URLs (HMAC of the generation id). `openssl rand -hex 32`
HF_WEBHOOK_SECRET=
# (required) `whsec_…` signing secret revealed in Higgsfield Console Settings.
# Signed deliveries are verified against the raw body and a five-minute window.
HF_WEBHOOK_SIGNING_SECRET=
# (required in production) Public HTTPS origin Higgsfield can reach, e.g. https://vireo.studio.
# Empty = no webhooks; the reconciler finishes runs (fine for local dev).
HF_WEBHOOK_BASE_URL=
# Compare each submit with POST /estimate before charging (recommended).
HF_PRICE_GUARD=true
# Runs still unfinished after this many minutes are stopped and refunded.
RUN_TIMEOUT_MINUTES=30

# Credits --------------------------------------------------------------------
# Retail value of one credit before plan discounts.
CREDIT_USD_VALUE=0.01
# Sell at this multiple of the Higgsfield API cost.
CREDIT_MARKUP=2.0

# Stripe ---------------------------------------------------------------------
# (required) sk_live_… / sk_test_…
STRIPE_SECRET_KEY=
# (required) whsec_… from the webhook endpoint (or `stripe listen`).
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring prices (monthly / annual) and one-time top-up prices.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_ANNUAL=
STRIPE_PRICE_TOPUP_SMALL=
STRIPE_PRICE_TOPUP_MEDIUM=
STRIPE_PRICE_TOPUP_LARGE=

# Cloudflare R2 --------------------------------------------------------------
# (required) Every finished output is copied here (the platform keeps them ≥ 7 days).
# Empty in development → files go to .data/media and are served by /api/media.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (custom domain or r2.dev), no trailing slash.
R2_PUBLIC_BASE_URL=
# Optional S3 endpoint override (e.g. MinIO for local testing).
R2_ENDPOINT=

# Cron -----------------------------------------------------------------------
# (required) Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Testing --------------------------------------------------------------------
# Enables /api/test/mailbox for Playwright (ignored in production).
E2E_TEST_MODE=false

# Required on preview deploys that run E2E (sent as x-e2e-secret).
E2E_SECRET=
